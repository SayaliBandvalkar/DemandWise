# DemandWise Environment Configuration Example
# Copy to .env for local overrides if needed

DEMANDWISE_ENV=development
DEMANDWISE_DATA_DIR=data
DEMANDWISE_ARTIFACTS_DIR=artifacts
DEMANDWISE_REPORTS_DIR=reports
DEMANDWISE_DB_PATH=artifacts/demandwise_audit.db
DEMANDWISE_RANDOM_SEED=42
DEMANDWISE_LOG_LEVEL=INFO
